APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS="your-gmail-address@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail App Password hướng dẫn:
# 1. Bật 2FA cho tài khoản Gmail của bạn.
# 2. Vào https://myaccount.google.com/security -> App passwords.
# 3. Tạo app password cho Mail và copy giá trị vào MAIL_PASSWORD.
# 4. Nếu dùng local, giữ MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls.

# Brevo HTTP API — dùng khi deploy Railway (Railway chặn SMTP ở gói Free/Hobby)
# 1. Đăng ký https://www.brevo.com -> Senders, Domains & Dedicated IPs -> Senders: thêm và xác minh Gmail người gửi.
# 2. SMTP & API -> API Keys: tạo API key (dạng xkeysib-...).
# 3. MAIL_FROM_ADDRESS phải trùng với sender đã xác minh trên Brevo.
# MAIL_MAILER=brevo
# BREVO_API_KEY=xkeysib-your-api-key
# MAIL_FROM_ADDRESS=your-gmail-address@gmail.com
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Quy tắc nghiệp vụ khách sạn (config/hotel.php)
HOTEL_DEPOSIT_DEADLINE_HOURS=24
HOTEL_FINAL_DEADLINE_HOURS=24
HOTEL_PENDING_EXPIRE_HOURS=48
HOTEL_FREE_CANCELLATION_DAYS=3
